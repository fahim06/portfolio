# Environment variables for the portfolio (Vite static SPA)
# Vite only exposes variables prefixed with VITE_ to the client at build time.
# This project currently requires NO environment variables to build or run.

# Optional: canonical deployed URL (used for SEO / Open Graph tags if wired up).
# VITE_SITE_URL=https://your-portfolio-url.example.com

# NOTE: Never commit real secrets. `.env*` files are gitignored except this example.
