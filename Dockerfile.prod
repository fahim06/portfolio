# ---- Production image (static frontend) -------------------------------------
# Multi-stage: build the Vite bundle, then serve the static `dist/` with nginx.
#
# NOTE: This serves the FRONTEND only. The contact form's /api/contact backend
# is a Vercel serverless function (api/contact.js) and is NOT included here —
# production deployment runs through Vercel (see .github/workflows/ci.yml).
# Use this image only for self-contained static hosting of the SPA.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
# Static assets
COPY --from=build /app/dist /usr/share/nginx/html
# SPA fallback so client-side anchors/refreshes resolve to index.html
RUN printf 'server {\n\
  listen 80;\n\
  server_name _;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / { try_files $uri $uri/ /index.html; }\n\
}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
